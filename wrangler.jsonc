{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threat-feed",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "compromised.live", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threat-feed",
      "database_id": "7116fa02-ff05-48db-b195-445ae6d0a84c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SUMMARY_MODEL": "claude-haiku-5-5",
    "SITE_URL": "https://compromised.live",
    "SITE_NAME": "compromised.live"
  },
  "observability": { "enabled": true }
}
