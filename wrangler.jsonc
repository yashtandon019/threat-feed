{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threat-feed",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [
    { "pattern": "compromised.live", "custom_domain": true },
    { "pattern": "www.compromised.live", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threat-feed",
      "database_id": "7116fa02-ff05-48db-b195-445ae6d0a84c",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP limits on the endpoints that fan out to OSV; namespace ids only need to be unique in the account.
  "ratelimits": [
    { "name": "CHECK_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "REPO_URL": "https://github.com/yashtandon019/threat-feed",
    "SUMMARY_MODEL": "claude-haiku-5-5",
    "SITE_URL": "https://compromised.live",
    "SITE_NAME": "compromised.live"
  },
  "observability": { "enabled": true }
}
